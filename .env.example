# ---------- Postgres ----------
POSTGRES_USER=loregraph
POSTGRES_PASSWORD=loregraph
POSTGRES_DB=loregraph
POSTGRES_PORT=5432

# ---------- Backend ----------
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# ---------- Analyzer ----------
# Which analyzer is used by default when the client doesn't override the mode.
# "mock"  → regelbasierter Offline-Analyzer (kein Netzwerk, keine Kosten)
# "llm"   → semantische Analyse via OpenAI-kompatible API (siehe LLM_* unten)
ANALYZER_PROVIDER=mock

# ---------- LLM (OpenAI-compatible API) ----------
# Works with: OpenAI, OpenRouter, LM Studio, Ollama (mit /v1-Gateway), llama.cpp
# server, vLLM, jeder andere OpenAI-kompatible Endpunkt.
#
# Cloud (OpenAI):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4.1-mini
#
# Cloud (OpenRouter):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-3.5-sonnet
#
# Lokal (LM Studio):
#   LLM_BASE_URL=http://host.docker.internal:1234/v1
#   LLM_API_KEY=
#   LLM_MODEL=llama-3.1-8b-instruct
#
# Lokal (Ollama via OpenAI gateway):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=
#   LLM_MODEL=llama3.1
#   LLM_JSON_MODE=false   # Ollama mag response_format nicht immer

LLM_BASE_URL=https://api.openai.com/v1
# Trage hier deinen eigenen Key ein. NIEMALS einen echten Key in .env.example committen.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2

# Optional:
# LLM_MAX_TOKENS=4000
# LLM_JSON_MODE=true       # bei "false" wird response_format nicht gesendet
# LLM_TIMEOUT_MS=60000

# ---------- Bildgenerierung (OpenAI Images API) ----------
# Generiert Entitäts-Bilder via POST /api/images/generate.
# Base-URL und Key fallen auf LLM_BASE_URL / LLM_API_KEY zurück, wenn nicht
# gesetzt — mit einem OpenAI-Setup ist also keine zusätzliche Konfiguration nötig.
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
# IMAGE_BASE_URL=https://api.openai.com/v1   # default: LLM_BASE_URL
# IMAGE_API_KEY=sk-...                       # default: LLM_API_KEY
# IMAGE_TIMEOUT_MS=120000
# UPLOADS_DIR=/app/uploads                   # Speicherort der Bilder (default: <cwd>/uploads)
